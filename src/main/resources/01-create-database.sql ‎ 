CREATE DATABASE "bank-star.app"
    WITH
    OWNER = postgres
    ENCODING = 'UTF8'
    LC_COLLATE = 'en_US.UTF-8'
    LC_CTYPE = 'en_US.UTF-8'
    CONNECTION LIMIT = -1;


COMMENT ON DATABASE "bank-star.app" IS 'Bank Star Application Database';


CREATE USER "bank-star.app:user" WITH
    LOGIN
    NOSUPERUSER
    NOCREATEDB
    NOCREATEROLE
    INHERIT
    NOREPLICATION
    CONNECTION LIMIT -1
    PASSWORD 'money';


-- CREATE DATABASE bank_star_app;
-- CREATE USER bank_star_app WITH PASSWORD 'user';


GRANT ALL PRIVILEGES ON DATABASE "bank-star.app" TO "bank-star.app";


\c "bank-star.app"


CREATE SCHEMA IF NOT EXISTS bank_star_schema;


GRANT USAGE ON SCHEMA bank_star_schema TO "bank-star.app";
GRANT CREATE ON SCHEMA bank_star_schema TO "bank-star.app";
GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA bank_star_schema TO "bank-star.app";
GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA bank_star_schema TO "bank-star.app";
