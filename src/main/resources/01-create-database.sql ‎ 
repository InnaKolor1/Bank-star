CREATE DATABASE "transaction.mv.db"
    WITH
    OWNER =
    ENCODING = 'UTF8'
    LC_COLLATE = 'en_US.UTF-8'
    LC_CTYPE = 'en_US.UTF-8'
    CONNECTION LIMIT = -1;


COMMENT ON DATABASE "transaction.mv.db" IS 'Bank Star Application Database';


CREATE USER "" WITH
    LOGIN
    NOSUPERUSER
    NOCREATEDB
    NOCREATEROLE
    INHERIT
    NOREPLICATION
    CONNECTION LIMIT -1
    PASSWORD 'money';


-- CREATE DATABASE transaction.mv.db;
-- CREATE USER "" WITH PASSWORD '';


GRANT ALL PRIVILEGES ON DATABASE "transaction.mv.db" TO "";


\c "transaction.mv.db"


CREATE SCHEMA IF NOT EXISTS bank_star_schema;


GRANT USAGE ON SCHEMA bank_star_schema TO "transaction.mv.db";
GRANT CREATE ON SCHEMA bank_star_schema TO "transaction.mv.db";
GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA bank_star_schema TO "transaction.mv.db";
GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA bank_star_schema TO "transaction.mv.db";

