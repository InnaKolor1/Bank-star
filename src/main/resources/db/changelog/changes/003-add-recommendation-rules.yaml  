                  value: 5000.00

        - createTable:
            tableName: recommendation_history
            columns:
              - column:
                  name: id
                  type: UUID
                  constraints:
                    primaryKey: true
                    nullable: false
              - column:
                  name: user_id
                  type: UUID
                  constraints:
                    nullable: false
              - column:
                  name: recommendation_id
                  type: UUID
                  constraints:
                    nullable: false
              - column:
                  name: created_at
                  type: TIMESTAMP
                  defaultValueComputed: CURRENT_TIMESTAMP
              - column:
                  name: status
                  type: VARCHAR(50)
                  defaultValue: 'SENT'

        - addForeignKeyConstraint:
            baseTableName: recommendation_history
            baseColumnNames: user_id
            constraintName: fk_recommendation_history_user
            referencedTableName: user_financial_metrics
            referencedColumnNames: user_id

        - addForeignKeyConstraint:
            baseTableName: recommendation_history
            baseColumnNames: recommendation_id
            constraintName: fk_recommendation_history_recommendation
            referencedTableName: dynamic_rules
            referencedColumnNames: id